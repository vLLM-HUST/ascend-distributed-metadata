{
  "schema_version": 1,
  "id": "adm",
  "repository": "ascend-distributed-metadata",
  "source_subdir": "src",
  "entrypoint": {
    "group": "vllm.general_plugins",
    "name": "adm_packed_sync"
  },
  "parameters": {},
  "activation": {
    "vllm_plugins": [
      "ascend",
      "ascend_kv_connector",
      "ascend_model",
      "ascend_model_loader",
      "ascend_service_profiling",
      "adm_packed_sync"
    ],
    "environment": {
      "ADM_PACKED_SYNC_ENABLE": "1"
    },
    "extra_env_keys": ["ADM_PACKED_SYNC_ENABLE"],
    "extra_args": [
      "--tensor-parallel-size", "4",
      "--data-parallel-size", "2"
    ]
  },
  "compatibility": {
    "incompatible_with": ["adm-local-observer", "adm-runtime-observer"],
    "model_qualifications": [
      {
        "model": "Qwen3.5-35B-A3B",
        "tensor_parallel_size": 4,
        "data_parallel_size": 2,
        "status": "pending-runtime-qualification"
      }
    ]
  }
}
